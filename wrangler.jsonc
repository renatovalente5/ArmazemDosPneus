// O SITE NA CLOUDFLARE: um Worker só com ficheiros estáticos — a pasta _site
// que o CI prepara (.github/workflows/pages.yml). Sem código: cada pedido é
// servido directamente, sem contar para a quota de pedidos do Worker.
//
// PORQUÊ: os termos do GitHub Pages proíbem usá-lo para uma loja online
// («not intended for or allowed to be used … to run your online business,
// e-commerce site» — GitHub Terms for Additional Products and Features, Pages).
//
// PUBLICA-SE SÓ PELO CI. A _site é preparada lá (fotos do backoffice reduzidas
// e injectadas no HTML, _redirects gerado a partir das páginas que existem);
// um `wrangler deploy` à mão não a tem. O Worker dos pagamentos é outro, em
// worker/ — este ficheiro não lhe toca.
{
  "name": "armazem-dos-pneus-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./_site",
    // AS MORADAS SÃO AS DO .html: os canonicals, o sitemap e as ligações
    // dizem /loja.html. Com o valor por omissão («auto-trailing-slash») a
    // Cloudflare mandava /loja.html para /loja com um 307, contra os
    // canonicals. Com «none» serve-se o ficheiro pedido; a página inicial,
    // o /admin/ e as moradas sem .html (que o GitHub Pages aceitava) vêm do
    // _redirects que o CI escreve.
    "html_handling": "none",
    // Uma morada que não existe mostra a 404.html (sem ela, a Cloudflare
    // devolvia uma página em branco).
    "not_found_handling": "404-page"
  },
  // O DOMÍNIO CHEGA POR ROUTE, E NÃO POR «CUSTOM DOMAIN». Um Custom Domain
  // obriga a apagar primeiro os registos A que lá estão (apontavam para o
  // GitHub Pages); um resolvedor que pergunte nesse intervalo guarda a falta
  // durante o mínimo do SOA (1800 s, que no plano Free não se muda). Com uma
  // route, os A ficam onde estão e só passam a «Proxied»: a resposta nunca
  // fica vazia, e todo o pedido ao domínio é servido por estes ficheiros (a
  // origem nunca é contactada). O www vai para o apex por uma Redirect Rule
  // da zona. «teste» é o ensaio num subdomínio descartável; sai a seguir.
  "routes": [
    { "pattern": "armazemdospneus.pt/*", "zone_name": "armazemdospneus.pt" },
    { "pattern": "teste.armazemdospneus.pt/*", "zone_name": "armazemdospneus.pt" }
  ],
  // O endereço de ensaio em workers.dev fica ligado até o domínio passar para
  // aqui; depois desliga-se.
  "workers_dev": true,
  "preview_urls": false
}
